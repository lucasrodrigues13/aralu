# Copie para .env e preencha. O .env não entra no Git.
# Na VPS o caminho é /opt/aralu/.env
# No seu computador, o mesmo arquivo ao lado do compose.yaml libera o e-mail do ambiente local.

# IP público da VPS, sem http:// e sem barra.
# Exemplo: 1.2.3.4
DOMAIN=

# Banco. A porta não é publicada. Evite os caracteres $ e ; na senha.
POSTGRES_USER=aralu
POSTGRES_PASSWORD=
POSTGRES_DB=aralu

# Pelo menos 32 caracteres. Gere na VPS com: openssl rand -base64 48
JWT_SECRET=

# Outlook (Microsoft 365): smtp.office365.com, porta 587. USERNAME é o e-mail oficial da caixa;
# EMAIL_FROM deve ser essa mesma caixa. O SMTP AUTH precisa estar habilitado nela.
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_STARTTLS=true
EMAIL_USERNAME=
EMAIL_FROM=

# Autenticação do SMTP. Preencha UMA das duas formas:
# 1) OAuth2 pelo Entra ID (recomendado): app com a permissão SMTP.SendAsApp, registrado no Exchange
#    com New-ServicePrincipal e Add-MailboxPermission. Quando as três linhas estão preenchidas,
#    EMAIL_PASSWORD é ignorada.
EMAIL_TENANT_ID=
EMAIL_CLIENT_ID=
EMAIL_CLIENT_SECRET=
# 2) Usuário e senha da caixa (autenticação básica, em retirada pela Microsoft).
EMAIL_PASSWORD=

# true só no primeiro deploy, para criar o administrador. Depois volte para false.
# A senha precisa de 8 caracteres e de uma letra minúscula.
BOOTSTRAP_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
