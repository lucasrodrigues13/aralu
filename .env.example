# Copie para .env e preencha. O .env não entra no Git.
# Na VPS: produção em /opt/aralu/.env e staging em /opt/aralu-staging/.env
# No seu computador, o mesmo arquivo ao lado do compose.yaml libera o e-mail do ambiente local.

# Domínio (ou IP) público, sem http:// e sem barra.
# Produção: aralu.com.br   Staging: staging.aralu.com.br
DOMAIN=
# https quando o proxy já serve o domínio com certificado; http para acessar pelo IP.
PUBLIC_SCHEME=http

# production ou staging. Em staging ficam liberadas as ferramentas de teste.
APP_ENV=production

# Porta local do frontend, que o proxy em /opt/proxy repassa. Produção 8081, staging 8082.
FRONTEND_PORT=8081

# Limite de memória dos containers. Sugestão no staging: 512m nos dois.
POSTGRES_MEM_LIMIT=1g
API_MEM_LIMIT=1g

# Banco. A porta não é publicada. Evite os caracteres $ e ; na senha.
POSTGRES_USER=aralu
POSTGRES_PASSWORD=
POSTGRES_DB=aralu

# Pelo menos 32 caracteres. Gere na VPS com: openssl rand -base64 48
JWT_SECRET=

# Outlook (Microsoft 365): smtp.office365.com, porta 587. USERNAME é o e-mail oficial da caixa;
# EMAIL_FROM deve ser essa mesma caixa. O SMTP AUTH precisa estar habilitado nela.
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_STARTTLS=true
EMAIL_USERNAME=
EMAIL_FROM=

# Autenticação do SMTP. Preencha UMA das duas formas:
# 1) OAuth2 pelo Entra ID (recomendado): app com a permissão SMTP.SendAsApp, registrado no Exchange
#    com New-ServicePrincipal e Add-MailboxPermission. Quando as três linhas estão preenchidas,
#    EMAIL_PASSWORD é ignorada.
EMAIL_TENANT_ID=
EMAIL_CLIENT_ID=
EMAIL_CLIENT_SECRET=
# 2) Usuário e senha da caixa (autenticação básica, em retirada pela Microsoft).
EMAIL_PASSWORD=

# true só no primeiro deploy, para criar o administrador. Depois volte para false.
# A senha precisa de 8 caracteres e de uma letra minúscula.
BOOTSTRAP_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD= 

# Asaas (cobrança). Sandbox: https://api-sandbox.asaas.com/v3 · Produção: https://api.asaas.com/v3
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3

# Asaas (SPEC-062). Chave e token ficam só aqui, no servidor; nunca no Git.
# Staging: sandbox (crie a chave em sandbox.asaas.com > Integrações) e diagnóstico ligado para ver as chamadas no DevTools.
# Produção: ASAAS_BASE_URL=https://api.asaas.com e ASAAS_DIAGNOSTICO=false.
ASAAS_BASE_URL=https://api-sandbox.asaas.com
ASAAS_API_KEY=
# authToken do webhook (32 a 255 caracteres, sem espaços). O mesmo valor vai na configuração do webhook no Asaas.
ASAAS_WEBHOOK_TOKEN=
ASAAS_DIAGNOSTICO=true
